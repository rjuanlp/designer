+    // DESIGNER PATCH (begin)
+    /// Paint a texture shared by another graphics device into the scene for the
+    /// next frame at the current z-index, clipped by the current content mask.
+    ///
+    /// This method should only be called as part of the paint phase of element drawing.
+    #[cfg(target_os = "windows")]
+    pub fn paint_external_texture(
+        &mut self,
+        bounds: Bounds<Pixels>,
+        texture: crate::ExternalTexture,
+    ) {
+        use crate::PaintSurface;
+
+        self.invalidator.debug_assert_paint();
+
+        let scale_factor = self.scale_factor();
+        // Snap to whole device pixels so texels map one to one onto the
+        // window and the canvas is not resampled at fractional positions.
+        let bounds = bounds.scale(scale_factor);
+        let bounds = Bounds {
+            origin: Point {
+                x: bounds.origin.x.round(),
+                y: bounds.origin.y.round(),
+            },
+            size: Size {
+                width: bounds.size.width.round(),
+                height: bounds.size.height.round(),
+            },
+        };
+        let content_mask = self.content_mask().scale(scale_factor);
+        self.next_frame.scene.insert_primitive(PaintSurface {
+            order: 0,
+            bounds,
+            content_mask,
+            texture,
+        });
+    }
