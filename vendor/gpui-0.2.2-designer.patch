+// DESIGNER PATCH (begin): Windows external GPU texture description.
+
+/// A point on a shared GPU fence, used to order work between another graphics
+/// device and the window's Direct3D 11 device without blocking the CPU.
+#[cfg(target_os = "windows")]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ExternalFencePoint {
+    /// Identity of the fence object. A new fence must use a new id, even if
+    /// the operating system reuses the numeric handle value.
+    pub fence_id: u64,
+    /// NT shared handle of a fence created with sharing enabled.
+    pub shared_handle: isize,
+    /// Fence value to wait for or to signal.
+    pub value: u64,
+}
+
+/// A texture produced by another graphics device on the same adapter and
+/// shared through an NT handle, to be composited in element paint order.
+///
+/// The handles stay owned by the caller and must remain open until the frame
+/// that paints them has been drawn. The renderer keeps its own references to
+/// the opened objects and releases them when they stop being painted.
+#[cfg(target_os = "windows")]
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ExternalTexture {
+    /// Identity of the texture object. A new texture must use a new id, even
+    /// if the operating system reuses the numeric handle value.
+    pub id: u64,
+    /// NT shared handle of a 2D texture that allows shader sampling. Color is
+    /// sampled as sRGB-encoded RGBA with straight (non-premultiplied) alpha.
+    pub shared_handle: isize,
+    /// The producer signals this point when the texture content is complete;
+    /// the renderer queues a GPU-side wait for it before sampling.
+    pub wait: Option<ExternalFencePoint>,
+    /// The renderer signals this point after its sampling draw call, so the
+    /// producer knows when the texture may be written again.
+    pub signal: Option<ExternalFencePoint>,
+}
+
+// DESIGNER PATCH (end)
+
